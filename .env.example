# Copy to .env.local and set only what you use.

# Plausible
VITE_PLAUSIBLE_DOMAIN=wtfdoieat.app

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend feature flags for secure proxy usage
VITE_ENABLE_GOOGLE_PROXY=true
VITE_ENABLE_SERP_PROXY=true

# Server-side provider keys (do NOT prefix these with VITE_)
GOOGLE_PLACES_API_KEY=
SERPAPI_KEY=

# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
APP_BASE_URL=http://localhost:3000
BILLING_ADMIN_SECRET=
METRICS_ADMIN_SECRET=
